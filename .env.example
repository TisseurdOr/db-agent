# LLM API（兼容 Anthropic SDK，可换 OpenAI / Kimi / DeepSeek 等）
ANTHROPIC_API_KEY=sk-your-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-chat

# Eval 独立评测模型（建议用和被评 Agent 不同的模型，避免自评偏差）
KIMI_API_KEY=sk-your-kimi-key
KIMI_BASE_URL=https://api.moonshot.cn/anthropic
KIMI_MODEL=kimi-k2.5

# Embedding（用于向量记忆 / Schema Linking / few-shot / 自学习）
# 走 OpenAI 兼容的 /v1/embeddings 接口，任何兼容服务都行。三选一：
#
#  ① 本地 Ollama（离线、免费，推荐本地开发）：
#     ollama pull nomic-embed-text
#     EMBEDDING_API_KEY=ollama
#     EMBEDDING_BASE_URL=http://localhost:11434/v1
#     EMBEDDING_MODEL=nomic-embed-text      # 768 维
#
#  ② 阿里云百炼 DashScope：
#     EMBEDDING_API_KEY=sk-xxxx
#     EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     EMBEDDING_MODEL=text-embedding-v3     # 以控制台实际可用模型名为准
#
#  ③ OpenAI：
#     EMBEDDING_API_KEY=sk-xxxx
#     EMBEDDING_BASE_URL=https://api.openai.com/v1
#     EMBEDDING_MODEL=text-embedding-3-small
#
# 注意：换 embedding 模型必须重建向量库（维度不同会报 dimension mismatch，
#       或召回变垃圾）——删掉 harness/memory/chroma_db 后重启即可重建。
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text

# Jev（TypeSafe 的 System One 决策模型）——可选增强，只影响**判断节点**
# （Router 选 Agent、SQL 置信度评估），**不影响主 LLM**（主 LLM 仍走 ANTHROPIC_*）。
# 不配任何 key = 完全走原来的 LLM 路径，行为不变。
#
# 两条通道（二选一；若两个都配，OpenRouter 优先）：
#
#  ① OpenRouter（推荐，只需一个 OpenRouter key，不用单独申请 TypeSafe）
#     OPENROUTER_API_KEY=sk-or-xxxx
#     OPENROUTER_BASE_URL=https://openrouter.ai/api/v1     # 默认即此，可省略
#     JEV_MODEL=typesafe/jev-router                        # 默认即此，可省略
#
#  ② TypeSafe 原生 API（状态 + 类型化问题 → 校准概率）
#     JEV_API_KEY=xxxx
#     JEV_BASE_URL=https://api.typesafe.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-router
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
# 启动时是否自动建知识库向量索引：1（默认）自动建，0 跳过。
# 测试/离线环境建议设 0，避免写共享持久化向量库。
KB_INDEX_AUTOBUILD=1

# 默认用户角色（viewer / analyst / dba / manager / support）
AGENT_USER=dba              # 仅 dba/经理可查库

# Token 预算——上下文窗口软预算，超 70% 触发压缩
TOKEN_BUDGET_MAX=32000
TOKEN_BUDGET_WARN=0.7

# 压缩摘要用便宜模型
COMPRESS_MODEL=deepseek-v4-flash

# Tool 返回结果最大字符数，超出截断
TOOL_RESULT_MAX_LEN=8000

# API 重试（429/5xx/超时）；0 = 关闭
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# 熔断器（三层自愈第三层）：连续失败达到阈值 → 快速失败并降级，不再白烧 token
CIRCUIT_BREAKER_ENABLED=1            # 1 = 开启；0 = 关闭（默认开启）
CIRCUIT_BREAKER_THRESHOLD=5          # 连续失败多少次打开熔断
CIRCUIT_BREAKER_COOLDOWN=30          # 打开后冷却秒数，之后半开试探一次

# 工具调用幂等（防止重试/重规划重复执行副作用工具：保存记忆、HBase put/delete 等）
TOOL_IDEMPOTENCY_ENABLED=1            # 1 = 开启；0 = 关闭
TOOL_IDEMPOTENCY_TTL=300              # 秒；同工具+同参数成功执行后，窗口内不再重复执行

# Web API 鉴权。三种模式按下面两个变量自动切换：
#  A) 每用户 token（推荐，身份服务端推导，客户端不能自称 dba）
#     WEB_API_TOKENS="dba:tokDBA,zhoufang:tokMGR,viewer:tokVIEW"
#  B) 单 token（共享密钥，身份取服务端 AGENT_USER）
#     WEB_API_TOKEN="tok-shared"
#  C) 两者都不配 = 演示模式：不鉴权，前端"切角色"生效，RBAC 仅演示用
# 请求头：Authorization: Bearer <token> 或 X-API-Key: <token>
WEB_API_TOKEN=
WEB_API_TOKENS=

# /api/datasource/connect 允许打开的 SQLite 目录（默认项目根目录），防任意路径读取
DATASOURCE_ALLOWED_DIR=

# 告警（默认只写日志；配置 Webhook 后推送 Slack / 钉钉 / 飞书机器人）
ALERT_ENABLED=1
ALERT_WEBHOOK_URL=                    # 例如 https://hooks.slack.com/services/xxx（留空 = 仅日志）

# 向量库后端（可选）：chroma（默认，本地嵌入式）/ milvus（Milvus Lite 嵌入式或集群）
# MILVUS_URI 只用于 http(s):// 集群地址；本地 Lite 不需要配置（默认 milvus_lite.db）
VECTOR_DB=chroma
MILVUS_URI=

# Redis 状态外置（可选）：配置后 Web 会话存 Redis（多实例共享）；checkpoint 也走 Redis（需 redis-stack）
# 未配置 / Redis 不可用 → 自动回落内存 / SQLite，不影响运行
REDIS_URL=                        # 例如 redis://localhost:6379/0
REDIS_CHECKPOINT_TTL_MINUTES=1440 # checkpoint 保留时长（分钟）；默认 24h 自动清理，防无限膨胀

# 成功 SQL 自动回流样例库；0 / false = 关闭写路径（读 few-shot 不受影响）
AUTO_LEARN_SQL=1

# Opik AI Observability（默认关闭；本地 UI: http://localhost:5173）
OPIK_ENABLED=0
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_PROJECT_NAME=db-agent
# Comet Cloud 才需要下面两项：
# OPIK_API_KEY=
# OPIK_WORKSPACE=

# LangFuse LLM 可观测性（默认关闭；与 Opik 二选一或并存。本地自托管 UI: http://localhost:3000）
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Trace JSONL 保留天数（logs/traces/YYYY-MM-DD.jsonl）；0 = 不自动删除
TRACE_RETENTION_DAYS=30
# save() 时触发清理的概率（启动时总会清理一次）
# TRACE_CLEANUP_PROB=0.01
